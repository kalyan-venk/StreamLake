# Copy to .env and source it (`set -a; . ./.env; set +a`) to override any config value.

# Spark needs a JDK it supports; JDK 25 is not one of them.
JAVA_HOME=/Library/Java/JavaVirtualMachines/jdk-17.jdk/Contents/Home

# --- dataset -------------------------------------------------------------------------
# Sparkov card transactions ship as two fixed CSVs (no per-period file to pick), so there is no
# equivalent of a month knob here; the period the data covers is in conf/streamlake.yml.

# --- lakehouse -----------------------------------------------------------------------
# Local filesystem (default). Point at MinIO or S3 to run the same code against object storage
# (verified end to end against MinIO: 1,852,394 rows landed as real S3 objects, see
# the README "PII" and object-storage sections for the two-jar detail this needs):
#   ICEBERG_WAREHOUSE=s3a://streamlake/warehouse
#   AWS_S3_ENDPOINT=http://localhost:9000
#   AWS_S3_PATH_STYLE=true
#   AWS_ACCESS_KEY_ID=minioadmin
#   AWS_SECRET_ACCESS_KEY=minioadmin
#   SPARK_EXTRA_PACKAGES=org.apache.iceberg:iceberg-aws-bundle:1.11.0,org.apache.hadoop:hadoop-aws:3.4.1
ICEBERG_CATALOG_TYPE=hadoop
ICEBERG_WAREHOUSE=warehouse

# --- contracts -----------------------------------------------------------------------
# fail = a breach aborts the task and therefore the DAG. warn = record it and continue.
CONTRACT_MODE=fail

# --- streaming -----------------------------------------------------------------------
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_TOPIC=streamlake.transactions
PRODUCER_EPS=400
PRODUCER_DUP_RATE=0.05
STREAM_RUN_SECONDS=120

# --- warehouse -----------------------------------------------------------------------
WAREHOUSE_TARGET=duckdb
# Set these and WAREHOUSE_TARGET=snowflake to serve from Snowflake instead of DuckDB.
# SNOWFLAKE_ACCOUNT=
# SNOWFLAKE_USER=
# SNOWFLAKE_PASSWORD=
# SNOWFLAKE_ROLE=ACCOUNTADMIN
# SNOWFLAKE_WAREHOUSE=COMPUTE_WH
# SNOWFLAKE_DATABASE=STREAMLAKE
# SNOWFLAKE_SCHEMA=RAW
